# YouTube Data API — same channel as trends-video-pipeline
# Prefer: junction/symlink secrets/ → ../trends-video-pipeline/secrets
# Or copy client_secrets.json + token.json into secrets/

YOUTUBE_CLIENT_SECRETS=secrets/client_secrets.json
YOUTUBE_REFRESH_TOKEN=
SKIP_YOUTUBE_UPLOAD=false

# Free narration via Groq (https://console.groq.com/)
GROQ_API_KEY=

DB_PATH=runs.db
