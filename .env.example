# YouTube Data API — same channel as trends-video-pipeline
# Prefer: junction/symlink secrets/ → ../trends-video-pipeline/secrets
# Or copy client_secrets.json + token.json into secrets/
#
# Multi-client upload failover (ordered in config/pipeline.yaml youtube.clients):
#   python -m src.youtube.auth --client primary
#   python -m src.youtube.auth --client backup1
# Add another later: secrets/clients/backup2/ + yaml entry + auth --client backup2

YOUTUBE_CLIENT_SECRETS=secrets/client_secrets.json
YOUTUBE_REFRESH_TOKEN=
SKIP_YOUTUBE_UPLOAD=false

# LLM narration chain (multi-provider fallback)
# Quality-first chain (best model first, then cheaper/faster fallbacks):
LLM_CHAIN=groq/openai/gpt-oss-120b,gemini/gemini-3.6-flash,groq/openai/gpt-oss-20b,gemini/gemini-3.5-flash-lite,gemini/gemini-flash-lite-latest,openrouter/nvidia/nemotron-3-super-120b-a12b:free,openrouter/cohere/north-mini-code:free,openrouter/poolside/laguna-s-2.1:free
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACKS=gemini/gemini-3.6-flash,groq/openai/gpt-oss-20b,gemini/gemini-3.5-flash-lite,gemini/gemini-flash-lite-latest,openrouter/nvidia/nemotron-3-super-120b-a12b:free,openrouter/cohere/north-mini-code:free,openrouter/poolside/laguna-s-2.1:free

GROQ_API_KEY=
GEMINI_API_KEY=
# GOOGLE_API_KEY=
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

DB_PATH=runs.db
