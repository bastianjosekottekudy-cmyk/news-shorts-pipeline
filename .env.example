# YouTube Data API — same channel as trends-video-pipeline
# Prefer: junction/symlink secrets/ → ../trends-video-pipeline/secrets
# Or copy client_secrets.json + token.json into secrets/
#
# Multi-client upload failover (ordered in config/pipeline.yaml youtube.clients):
#   python -m src.youtube.auth --client primary
#   python -m src.youtube.auth --client backup1
# Add another later: secrets/clients/backup2/ + yaml entry + auth --client backup2

YOUTUBE_CLIENT_SECRETS=secrets/client_secrets.json
YOUTUBE_REFRESH_TOKEN=
SKIP_YOUTUBE_UPLOAD=false

# LLM narration chain (same shape as ../comm-assistant)
# Sync secrets from comm-assistant:
#   .\scripts\sync-llm-env-from-comm-assistant.ps1
#
# Groq (Aug 2026): llama-3.1-8b-instant / llama-3.3-70b-versatile shut down.
# Prefer quality-first chain (best model first, then cheaper/faster fallbacks):
# LLM_CHAIN=gemini/gemini-3.5-flash,groq/openai/gpt-oss-120b,gemini/gemini-flash-latest,groq/openai/gpt-oss-20b
# or:
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
# LLM_FALLBACKS=groq/openai/gpt-oss-120b,groq/openai/gpt-oss-20b
# LLM_API_KEY=
# LLM_BASE_URL=

GROQ_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b

DB_PATH=runs.db
